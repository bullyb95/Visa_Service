<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="13.0.1" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Application\VisaService.Application.Services\VisaService.Application.Services.csproj" />
    <ProjectReference Include="..\..\Domain\VisaService.Domain.Repositories.Abstractions\VisaService.Domain.Repositories.Abstractions.csproj" />
    <ProjectReference Include="..\..\Infrastructure\VisaService.Infrastructure.EntityFramework\VisaService.Infrastructure.EntityFramework.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Repositories.Implementations\VisaService.Infrastructure.Repositories.Implementations.csproj" />
  </ItemGroup>

</Project>
